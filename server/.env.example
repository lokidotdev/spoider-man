# Server (Render) — copy to server/.env for local use.

# Port to listen on. Render injects this automatically; do NOT set it there.
# Locally it defaults to 3001, which is what the Vite dev proxy expects.
PORT=3001

# Comma-separated list of browser origins allowed to open a socket.
# Must include your Vercel production domain, and any preview domains you
# want playable. No trailing slashes. '*' allows everything (dev only).
CLIENT_ORIGIN=https://your-app.vercel.app,http://localhost:5173
