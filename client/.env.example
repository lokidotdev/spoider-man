# Client (Vercel) — copy to client/.env.local for local overrides.
# Vite only exposes variables prefixed with VITE_ to browser code, and it
# inlines them at BUILD time: changing this on Vercel requires a redeploy.

# Origin of the game server on Render. No trailing slash.
# Leave EMPTY/unset for local dev — the Vite proxy then forwards /socket.io
# to http://localhost:3001 instead.
VITE_SERVER_URL=https://your-service.onrender.com
